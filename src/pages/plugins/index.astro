---
import PortalLayout from '../../layouts/PortalLayout.astro';
import registry from '../../data/plugins.json';
type Plugin = { slug: string; name: string; description: string; author: string; repository: string; category: string; frameworks: string[] };
const plugins: Plugin[] = registry as Plugin[];
const base = import.meta.env.BASE_URL;
const packages = [
  { name:'Support', description:'Shared PHP component contracts, immutable composition and versioned JSON serialization.', url:'https://github.com/lavertia/support', phase:'Experimental' },
  { name:'Panels', description:'Optional Laravel pages, route registration and Inertia adapter installation.', url:'https://github.com/lavertia/panels', phase:'Draft' },
  { name:'Tables / Forms', description:'Dedicated package extraction is planned; component prototypes currently live in Panels.', url:'https://github.com/lavertia', phase:'Planned' },
];
---
<PortalLayout title="Plugins & ecosystem" description="Discover official Lavertia packages and carefully reviewed third-party extensions.">
  <p class="eyebrow">The Lavertia ecosystem</p>
  <h1 class="page-title">Build beyond the core.</h1>
  <p class="page-lead">Official building blocks and a community plugin directory, modeled around compatibility and clear ownership. Listings are curated through pull requests.</p>
  <div class="row-between" style="flex-wrap:wrap">
    <span class="pill">{plugins.length} community plugins listed</span>
    <a class="button primary" href="https://github.com/lavertia/lavertia-doc/issues/new?template=plugin-submission.yml" target="_blank" rel="noopener noreferrer">Submit a plugin ↗</a>
  </div>
  <h2 class="section-title">Official packages</h2>
  <div class="content-grid">
    {packages.map(item => (
      <a class="portal-card" href={item.url} target="_blank" rel="noopener noreferrer">
        <div class="row-between"><span class="kicker">Lavertia</span><span class="pill">{item.phase}</span></div>
        <h3>{item.name}</h3><p>{item.description}</p><span class="muted">View source ↗</span>
      </a>
    ))}
  </div>
  <h2 class="section-title">Community plugins</h2>
  {plugins.length > 0 && <div class="portal-search"><label for="plugin-search">Search plugins by name, author or description</label><input id="plugin-search" type="search" placeholder="Search plugins…" autocomplete="off" /></div>}
  <div class="content-grid" id="plugin-results">
    {plugins.map(plugin => (
      <a class="portal-card plugin-result" href={base + 'plugins/' + plugin.slug + '/'} data-search={(plugin.name+' '+plugin.description+' '+plugin.author+' '+plugin.category).toLocaleLowerCase()}>
        <div class="row-between"><span class="kicker">{plugin.category}</span><span class="pill">{plugin.frameworks.join(' · ')}</span></div>
        <h3>{plugin.name}</h3><p>{plugin.description}</p><span class="muted">By {plugin.author} →</span>
      </a>
    ))}
  </div>
  {plugins.length === 0 && <div class="empty-state"><h2>Community directory opens with reviewed submissions.</h2><p>No third-party plugins have been approved for listing yet. You can still develop extensions and propose your project for review.</p><a class="button" href={base + 'guides/plugins/'}>Plugin author guide →</a></div>}
  {plugins.length > 0 && <p id="no-matches" class="muted" hidden>No plugins match your search.</p>}
  <script>
    const input = document.querySelector<HTMLInputElement>('#plugin-search');
    const cards = [...document.querySelectorAll<HTMLElement>('.plugin-result')];
    const message = document.querySelector<HTMLElement>('#no-matches');
    input?.addEventListener('input', () => {
      const query = input.value.trim().toLocaleLowerCase();
      let visible = 0;
      for (const card of cards) {
        const matches = (card.dataset.search ?? '').includes(query);
        card.hidden = !matches;
        if (matches) visible++;
      }
      if (message) message.hidden = visible !== 0;
    });
  </script>
</PortalLayout>
